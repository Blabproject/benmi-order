+
+/* ============================================================
+   PICKUP TIME BOTTOM SHEET & TRIGGER CARD (MOBILE-FIRST)
+   ============================================================ */
+
+/* 1. Trigger Card on Checkout Form */
+.pickup-time-trigger-card {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 13px 15px;
+    background: #ffffff;
+    border: 1.5px solid #e2e8f0;
+    border-radius: 12px;
+    cursor: pointer;
+    transition: all 0.2s ease;
+    user-select: none;
+    -webkit-tap-highlight-color: transparent;
+    margin-top: 6px;
+}
+
+.pickup-time-trigger-card:hover {
+    border-color: var(--primary);
+    background: #fbfdfb;
+}
+
+.pickup-time-trigger-card:active {
+    transform: scale(0.99);
+    background: #f0fdf4;
+}
+
+.pickup-trigger-left {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    min-width: 0;
+}
+
+.pickup-trigger-icon-box {
+    width: 40px;
+    height: 40px;
+    border-radius: 10px;
+    background: #f0fdf4;
+    color: var(--primary);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    flex-shrink: 0;
+}
+
+.pickup-trigger-text {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+}
+
+.pickup-trigger-primary {
+    font-size: 15.5px;
+    font-weight: 800;
+    color: #0f172a;
+    line-height: 1.3;
+}
+
+.pickup-trigger-secondary {
+    font-size: 12.5px;
+    font-weight: 600;
+    color: #64748b;
+    margin-top: 2px;
+}
+
+.pickup-trigger-chevron {
+    color: #94a3b8;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    flex-shrink: 0;
+    margin-left: 8px;
+}
+
+/* 2. Modal Overlay & Sheet */
+.pickup-time-modal {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background: rgba(15, 23, 42, 0.55);
+    backdrop-filter: blur(6px);
+    -webkit-backdrop-filter: blur(6px);
+    display: flex;
+    justify-content: center;
+    align-items: flex-end;
+    z-index: 9999;
+    padding: 0;
+    margin: 0;
+    box-sizing: border-box;
+    animation: pickupModalFadeIn 0.2s ease-out;
+}
+
+@keyframes pickupModalFadeIn {
+    from { opacity: 0; }
+    to { opacity: 1; }
+}
+
+.pickup-time-sheet {
+    background: #ffffff;
+    width: 100%;
+    max-width: 540px;
+    max-height: 85vh;
+    max-height: 85dvh;
+    border-radius: 24px 24px 0 0;
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+    box-shadow: 0 -12px 48px -4px rgba(0, 0, 0, 0.25);
+    margin: 0 auto;
+    animation: pickupSheetSlideUp 0.26s cubic-bezier(0.16, 1, 0.3, 1);
+    position: relative;
+    padding-bottom: calc(14px + env(safe-area-inset-bottom, 12px));
+}
+
+@keyframes pickupSheetSlideUp {
+    from {
+        transform: translateY(100%);
+        opacity: 0.5;
+    }
+    to {
+        transform: translateY(0);
+        opacity: 1;
+    }
+}
+
+@media (min-width: 640px) {
+    .pickup-time-modal {
+        align-items: center !important;
+        padding: 24px 16px !important;
+    }
+    .pickup-time-sheet {
+        border-radius: 20px !important;
+        max-height: 680px !important;
+        padding-bottom: 20px !important;
+        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.35) !important;
+    }
+}
+
+.pickup-sheet-handle {
+    width: 36px;
+    height: 4px;
+    border-radius: 999px;
+    background: #cbd5e1;
+    margin: 10px auto 4px;
+    flex-shrink: 0;
+}
+
+.pickup-sheet-header {
+    padding: 12px 20px 14px;
+    border-bottom: 1px solid #f1f5f9;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    position: sticky;
+    top: 0;
+    background: #ffffff;
+    z-index: 10;
+}
+
+.pickup-sheet-title {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 17.5px;
+    font-weight: 900;
+    color: #0f172a;
+}
+
+.pickup-sheet-title svg {
+    color: var(--primary);
+}
+
+.pickup-sheet-close {
+    width: 38px;
+    height: 38px;
+    border-radius: 50%;
+    border: none;
+    background: #f1f5f9;
+    color: #64748b;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+    transition: all 0.15s ease;
+}
+
+.pickup-sheet-close:active {
+    background: #e2e8f0;
+    color: #1e293b;
+    transform: scale(0.95);
+}
+
+.pickup-sheet-body {
+    padding: 16px 20px;
+    overflow-y: auto;
+    -webkit-overflow-scrolling: touch;
+    flex: 1;
+}
+
+/* Date Selector Tabs */
+.pickup-date-tabs {
+    display: flex;
+    gap: 8px;
+    margin-bottom: 16px;
+    overflow-x: auto;
+    padding-bottom: 4px;
+    scrollbar-width: none;
+}
+
+.pickup-date-tabs::-webkit-scrollbar {
+    display: none;
+}
+
+.pickup-date-tab {
+    flex: 1;
+    min-width: 90px;
+    padding: 10px 12px;
+    background: #f8fafc;
+    border: 1.5px solid #e2e8f0;
+    border-radius: 12px;
+    text-align: center;
+    cursor: pointer;
+    transition: all 0.18s ease;
+    user-select: none;
+}
+
+.pickup-date-tab.active {
+    background: #f0fdf4;
+    border-color: var(--primary);
+    box-shadow: 0 2px 8px rgba(0, 185, 0, 0.15);
+}
+
+.pickup-date-tab-main {
+    font-size: 14px;
+    font-weight: 800;
+    color: #1e293b;
+}
+
+.pickup-date-tab.active .pickup-date-tab-main {
+    color: var(--primary);
+}
+
+.pickup-date-tab-sub {
+    font-size: 12px;
+    font-weight: 600;
+    color: #64748b;
+    margin-top: 2px;
+}
+
+.pickup-date-tab.active .pickup-date-tab-sub {
+    color: #166534;
+}
+
+/* ASAP Card */
+.pickup-asap-card {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 14px 16px;
+    background: #ffffff;
+    border: 2px solid #bbf7d0;
+    border-radius: 14px;
+    cursor: pointer;
+    margin-bottom: 18px;
+    transition: all 0.2s ease;
+    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.08);
+}
+
+.pickup-asap-card:hover {
+    border-color: var(--primary);
+}
+
+.pickup-asap-card.selected {
+    background: #f0fdf4;
+    border-color: var(--primary);
+    box-shadow: 0 0 0 2px rgba(0, 185, 0, 0.25);
+}
+
+.pickup-asap-left {
+    min-width: 0;
+}
+
+.pickup-asap-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    font-size: 12px;
+    font-weight: 800;
+    color: #15803d;
+    background: #dcfce7;
+    padding: 3px 8px;
+    border-radius: 6px;
+    margin-bottom: 6px;
+}
+
+.pickup-asap-title {
+    font-size: 15px;
+    font-weight: 900;
+    color: #0f172a;
+}
+
+.pickup-asap-desc {
+    font-size: 12.5px;
+    color: #64748b;
+    margin-top: 2px;
+}
+
+.pickup-asap-time {
+    font-size: 20px;
+    font-weight: 900;
+    color: var(--primary);
+    font-family: ui-monospace, monospace;
+    flex-shrink: 0;
+    margin-left: 12px;
+}
+
+/* Slots Section */
+.pickup-slots-section-title {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-bottom: 10px;
+    font-size: 13.5px;
+    font-weight: 800;
+    color: #334155;
+}
+
+.pickup-slots-step-hint {
+    font-size: 12px;
+    font-weight: 600;
+    color: #94a3b8;
+}
+
+.pickup-slots-grid {
+    display: grid;
+    grid-template-columns: repeat(4, 1fr);
+    gap: 8px;
+    margin-bottom: 12px;
+}
+
+@media (max-width: 380px) {
+    .pickup-slots-grid {
+        grid-template-columns: repeat(3, 1fr);
+    }
+}
+
+.pickup-slot-chip {
+    min-height: 46px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    background: #f8fafc;
